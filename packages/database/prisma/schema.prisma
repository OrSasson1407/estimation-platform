generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum BurnoutLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum EstimationStatus {
  ACTIVE
  SUPERSEDED
  MANUALLY_OVERRIDDEN
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  EXECUTIVE
  ENGINEERING_MANAGER
  TEAM_LEAD
  DEVELOPER
  STAKEHOLDER
}

enum RiskCategory {
  UNCLEAR_REQUIREMENTS
  TECH_UNFAMILIARITY
  DEVELOPER_OVERLOAD
  DEPENDENCY_BOTTLENECK
  EXTERNAL_DEPENDENCY
  SCOPE_CREEP
  BURNOUT_RISK
  ANOMALY
}

// ─── ORGANIZATION ────────────────────────────────────────────────────────────

model Organization {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  projects   Project[]
  developers Developer[]
  teams      Team[]
}

// ─── DEVELOPER ───────────────────────────────────────────────────────────────

model Developer {
  id              String           @id @default(cuid())
  externalId      String           @unique
  orgId           String
  org             Organization     @relation(fields: [orgId], references: [id])
  name            String
  email           String           @unique
  role            Role             @default(DEVELOPER)
  estimationAcc   Float            @default(0)
  avgTaskDuration Float            @default(0)
  cognitiveLoad   Float            @default(0)
  burnoutRisk     BurnoutLevel     @default(LOW)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  skills          DeveloperSkill[]
  velocityHistory VelocityRecord[]
  teamMemberships TeamMember[]
  assignments     TaskAssignment[]

  @@index([orgId])
  @@index([estimationAcc])
  @@index([cognitiveLoad])
}

model DeveloperSkill {
  id          String    @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  skill       String
  level       Int       @default(1)
  createdAt   DateTime  @default(now())

  @@unique([developerId, skill])
}

model VelocityRecord {
  id          String    @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  sprintId    String
  sprint      Sprint    @relation(fields: [sprintId], references: [id])
  points      Float
  hours       Float
  recordedAt  DateTime  @default(now())

  @@index([developerId])
}

// ─── TEAM ─────────────────────────────────────────────────────────────────────

model Team {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  createdAt DateTime     @default(now())

  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([teamId, developerId])
}

// ─── PROJECT ──────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  orgId       String
  org         Organization  @relation(fields: [orgId], references: [id])
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id])
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sprints     Sprint[]
  tasks       Task[]
  riskAlerts  RiskAlert[]

  @@index([orgId])
  @@index([status])
}

// ─── SPRINT ───────────────────────────────────────────────────────────────────

model Sprint {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  goal            String?
  startDate       DateTime
  endDate         DateTime
  status          SprintStatus     @default(PLANNED)
  createdAt       DateTime         @default(now())

  sprintTasks     SprintTask[]
  velocityRecords VelocityRecord[]

  @@index([projectId])
}

model SprintTask {
  id       String   @id @default(cuid())
  sprintId String
  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([sprintId, taskId])
}

// ─── TASK ─────────────────────────────────────────────────────────────────────

model Task {
  id              String           @id @default(cuid())
  externalId      String           @unique
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTaskId    String?
  parentTask      Task?            @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks        Task[]           @relation("SubTasks")
  title           String
  description     String           @db.Text
  storyPoints     Int?
  complexityScore Float            @default(0)
  techDebtScore   Float            @default(0)
  status          TaskStatus       @default(BACKLOG)
  priority        Priority         @default(MEDIUM)
  embedding       Float[]          @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  estimations     Estimation[]
  assignments     TaskAssignment[]
  sprintTasks     SprintTask[]
  blockedBy       TaskDependency[] @relation("BlockedTask")
  blocking        TaskDependency[] @relation("BlockingTask")

  @@index([projectId])
  @@index([status])
  @@index([priority])
}

model TaskAssignment {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([taskId, developerId])
}

model TaskDependency {
  id             String   @id @default(cuid())
  blockingTaskId String
  blockingTask   Task     @relation("BlockingTask", fields: [blockingTaskId], references: [id])
  blockedTaskId  String
  blockedTask    Task     @relation("BlockedTask", fields: [blockedTaskId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([blockingTaskId, blockedTaskId])
}

// ─── ESTIMATION ───────────────────────────────────────────────────────────────

model Estimation {
  id               String           @id @default(cuid())
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  generatedAt      DateTime         @default(now())
  optimisticHours  Float
  expectedHours    Float
  pessimisticHours Float
  confidenceScore  Float
  modelVersion     String
  factorWeights    Json
  similarTaskIds   String[]
  explanation      String           @db.Text
  status           EstimationStatus @default(ACTIVE)
  revisedBy        String?

  feedbackFlags    FeedbackFlag[]

  @@index([taskId])
  @@index([status])
}

model FeedbackFlag {
  id           String     @id @default(cuid())
  estimationId String
  estimation   Estimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)
  flaggedBy    String
  reason       String
  createdAt    DateTime   @default(now())
}

// ─── RISK ─────────────────────────────────────────────────────────────────────

model RiskAlert {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    RiskCategory
  severity    RiskSeverity @default(LOW)
  title       String
  description String       @db.Text
  resolved    Boolean      @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([projectId])
  @@index([severity])
  @@index([resolved])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([entityType, entityId])
}
