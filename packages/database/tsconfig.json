{
  "compilerOptions": {
    "target": "ES2020",

    "module": "CommonJS",
    "moduleResolution": "Node",

    "outDir": "dist",
    "rootDir": ".",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "incremental": true
  },

  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
