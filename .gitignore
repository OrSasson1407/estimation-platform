node_modules/
.env
dist/
build/
coverage/
.DS_Store
__pycache__/
*.pyc
# .gitignore (at monorepo root)
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.tsbuildinfo
.next/
out/

# Environment
.env
.env.local
.env.*.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Database
*.sqlite
*.sqlite3
postgres_data/
clickhouse_data/
redis_data/
zookeeper_data/
kafka_data/
kong_db_data/

# Cache
.eslintcache
.cache/
.turbo/

# Docker
.dockerignore
docker-compose.override.yml

# Testing
coverage/
.nyc_output/

# OS
Thumbs.db
.vscode-test
.env.test.local
EOF